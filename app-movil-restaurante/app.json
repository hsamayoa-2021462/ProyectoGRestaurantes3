{
  "expo": {
    "name": "Gastro",
    "slug": "app-movil-restaurante",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gastro",
    "userInterfaceStyle": "dark",
    "ios": { "supportsTablet": false },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#0a0c0f" },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": { "bundler": "metro" },
    "plugins": [
      [
        "expo-image-picker",
        { "photosPermission": "Gastro necesita acceso a tu galería para cambiar tu foto de perfil." }
      ]
    ]
  }
}